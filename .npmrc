# Keep npm output clean for new users: hide cosmetic deprecation warnings from
# electron-builder's internal dependency chain (glob@7, inflight, boolean, rimraf -
# unfixable upstream, see the "For Developers" note in the README).
# The security audit summary ("found X vulnerabilities") still prints at this level.
loglevel=error

# Hide the "N packages are looking for funding" informational lines
fund=false
